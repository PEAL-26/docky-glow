{
  "appId": "com.dockyglow.app",
  "productName": "Docky Glow",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico"
  },
  "mac": {
    "target": "dmg",
    "icon": "build/icon.icns",
    "category": "public.app-category.utilities"
  },
  "linux": {
    "target": "AppImage",
    "icon": "build/icon.png",
    "category": "Utility"
  }
}

